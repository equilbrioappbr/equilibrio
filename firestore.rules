rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // Dados pessoais do OAXO: somente o titular pode ler ou gravar.
    match /users/{userId}/appData/{documentId} {
      allow read, write: if owner(userId);
    }

    // Nenhuma coleção pública, feed, perfil social, seguidores ou publicações é habilitada.
  }
}
